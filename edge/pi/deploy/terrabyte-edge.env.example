# --- Serial ports: one per Arduino, up to four ---
#
# Use stable symlinks, never /dev/ttyUSB0 — those are assigned in probe order
# and shuffle across reboots.
#
# WHICH SYMLINK DEPENDS ON THE USB-SERIAL CHIP:
#
#   by-id   works only when the adapter carries a unique iSerial. You can tell
#           by looking: usb-1a86_USB_Serial-if00-port0 has none, whereas
#           usb-Arduino_Uno_A1B2C3-if00 does. Plug in two chips with no
#           iSerial (CH340/1a86 is the common one) and both want the SAME
#           by-id name — one silently wins and a pot goes missing.
#
#   by-path keyed on the physical USB port, so it is unique regardless of chip.
#           The trade-off is that moving a cable to another socket renames the
#           node. With CH340 adapters this is the only workable option.
#
# Find them with:  ls -l /dev/serial/by-id/ /dev/serial/by-path/
TB_SERIAL_PORTS=/dev/serial/by-path/platform-xhci-hcd.0-usb-0:1:1.0-port0,/dev/serial/by-path/platform-xhci-hcd.0-usb-0:2:1.0-port0
TB_SERIAL_BAUD=115200

TB_DEVICE_ID=replace-with-provisioned-gateway-id

# Allowlist of Arduino node ids, comma separated, up to four. Each Arduino
# carries its own id compiled into TelemetryConfig.local.h; readings from an
# id outside this list are rejected, which is what stops an Arduino cabled
# into the wrong gateway from writing to someone else's pot.
TB_EXPECTED_NODE_IDS=terrabyte-node-01,terrabyte-node-02

# The six-digit code the user types into the app to claim this gateway.
# Shown on the attached monitor. Must match device.claim_code in the backend.
TB_CLAIM_CODE=000000

# --- Pot configuration (optional) ---
# Which pot is plugged in is physical fact the person at the bench knows, so
# the edge is the authority for it: it computes the suggested irrigation volume
# itself and ships these two values alongside, and the backend warns when its
# own record disagrees. If the server owned these numbers instead, the same
# value would live in two places and drift without either side noticing.
#
# Keyed by node id, not positional, so an entry can never be applied to the
# wrong pot. A node id outside TB_EXPECTED_NODE_IDS is refused at startup —
# it is a typo, and a typo here sizes doses for a pot that is not there.
# One entry per pot: TB_POT_SUBSTRATE_ML=node-01:3000,node-02:1500
#
# Both are optional. Leave TB_POT_SUBSTRATE_ML out and the edge sends no
# suggestion at all, which makes the backend fall back to its pot-size table —
# better than a number nobody measured. Leave TB_POT_CROPS out and the formula
# uses its default moisture target (35%).
#TB_POT_SUBSTRATE_ML=replace-with-provisioned-arduino-node-id:3000
#TB_POT_CROPS=replace-with-provisioned-arduino-node-id:lettuce
# Crop codes: cherry_tomato, lettuce, basil, peppermint, welsh_onion, arugula,
# wasabi, coriander.

TB_CROP_CONTEXT_ID=replace-with-active-crop-context-id
TB_CLOCK_MINIMUM_UTC=2025-01-01T00:00:00Z
TB_DATABASE_PATH=/var/lib/terrabyte-edge/outbox.sqlite3

# Live status for the on-screen display. Under /run so systemd deletes it when
# the bridge stops — a stale file would show dead readings as if they were live.
TB_STATUS_SNAPSHOT_PATH=/run/terrabyte-edge/status.json
TB_STATUS_SNAPSHOT_SECONDS=1

# mqtt (default) or http. MQTT is the operational transport; http is the
# debug/fallback path (design doc §6.6, §8.1).
TB_TRANSPORT=mqtt

# --- MQTT transport (used when TB_TRANSPORT=mqtt) ---
TB_MQTT_HOST=mosquitto.example.com
TB_MQTT_PORT=1883
# Provisioned per gateway alongside TB_DEVICE_ID; see mosquitto password file.
TB_MQTT_USERNAME=gw-replace-with-provisioned-gateway-id
TB_MQTT_PASSWORD=replace-with-provisioned-mqtt-password
TB_MQTT_TLS=false
TB_MQTT_TOPIC_PREFIX=tb/v2
TB_MQTT_KEEPALIVE_SECONDS=30
TB_MQTT_PUBLISH_TIMEOUT_SECONDS=10

# --- Command relay (irrigation commands; MQTT transport only) ---
#
# Subscribes to tb/v2/{TB_DEVICE_ID}/dn/command, judges the TTL, translates to
# the short-key serial command, and publishes the outcome to .../up/ack.
#
# On by default, and the reason is that the safety gate lives on the backend:
# its MQTT command dispatcher ships disabled, so a gateway with nothing
# publishing upstream never receives a command no matter what this says. One
# switch in one place beats two that can disagree. Set false to make this
# gateway ignore commands regardless of what the server does — the acks then
# stop too, so the server will expire every command it issues.
#TB_COMMAND_RELAY_ENABLED=true

# How many unprocessed commands may wait for the relay thread. Beyond it, the
# newest is refused with a CRITICAL log rather than queued: the queue exists so
# that paho's network thread never blocks (that would starve the MQTT
# keepalive), not to store a backlog. Commands have a two-minute TTL, so a deep
# queue would only be full of things that are about to expire anyway.
#TB_COMMAND_QUEUE_MAX=32

# Deadman tick, the sending half of the firmware's G3 watchdog: while a dose is
# running the Pi sends {"t":"ka"} at this interval, and the firmware stops the
# pump if it hears nothing for TB_HOST_TIMEOUT_MS (3000 ms). MUST stay well
# under that — the service refuses to start above 2 s — or every legitimate dose
# is cut short every few seconds and it looks like failing hardware.
#TB_COMMAND_DEADMAN_INTERVAL_SECONDS=1
# How long past the commanded runtime the tick keeps going while waiting for a
# terminal ack. When it lapses the ticking stops on purpose: if the pump were
# somehow still running, silence makes the firmware stop it within 3 s.
#TB_COMMAND_DEADMAN_GRACE_SECONDS=5

# Largest serial command frame the Pi will send. The firmware reads into a fixed
# buffer on a 2 KB device, so an over-long frame is a memory-safety event there
# rather than a parse error; a command that would exceed this is refused with
# reason NODE_OFFLINE instead. 96 bytes covers the widest legal frame (a
# 26-character ULID with both ms and ml).
#TB_COMMAND_MAX_SERIAL_BYTES=120

# How long the durable "already seen this command id" record is kept. QoS 1
# permits a duplicate at both hops and the firmware only remembers eight ids, so
# this is the defence that survives a restart. A day, against a two-minute
# command TTL.
#TB_COMMAND_JOURNAL_RETENTION_SECONDS=86400

# --- HTTP transport (used only when TB_TRANSPORT=http) ---
# Do not put the token in this environment file. Store it in the root-owned file.
#TB_DEVICE_TOKEN_FILE=/etc/terrabyte-edge.token
#TB_BACKEND_BASE_URL=https://api.example.com
#TB_HTTP_TIMEOUT_SECONDS=10

TB_UPLOAD_BATCH_SIZE=20
TB_OUTBOX_MAX_ROWS=100000
TB_UPLOAD_INTERVAL_SECONDS=2
TB_RETRY_BASE_SECONDS=2
TB_RETRY_MAX_SECONDS=300
TB_LOG_LEVEL=INFO
