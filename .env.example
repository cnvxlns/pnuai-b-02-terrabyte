# TerraByte Docker Compose 환경 변수 예시
#
# 사용법:
#   cp .env.example .env
#
# 이 파일의 값은 docker-compose.yml / docker-compose.prod.yml 이 자동으로 읽습니다.
# 여기에 적힌 자격 증명은 모두 "로컬 개발 전용" 기본값이며 배포 환경에서는 반드시 교체합니다.

# ---------------------------------------------------------------------------
# 툴체인 버전 고정 (컨테이너 안에서 사용할 런타임)
# ---------------------------------------------------------------------------
# Java: Spring Boot 3.5.16 / Gradle 8.14.3 조합에서 검증된 JDK 21 (LTS).
#       바이트코드 타깃은 build.gradle 의 sourceCompatibility(17) 그대로 유지됩니다.
JAVA_IMAGE=eclipse-temurin:21-jdk-jammy
JAVA_RUNTIME_IMAGE=eclipse-temurin:21-jre-jammy

# Gradle 버전은 이미지가 아니라 backend/gradle/wrapper/gradle-wrapper.properties 로 고정됩니다.
# 현재 고정 버전: Gradle 8.14.3

# Node / npm / npx: node 이미지 태그 하나가 node·npm·npx 버전을 함께 고정합니다.
# (npx 는 npm 에 포함되어 배포되므로 별도 고정이 필요 없습니다.)
# 컨테이너에 실제로 들어간 버전 확인: make versions
#
# node:22 은 npm 10 을 포함하는데, 현재 frontend/app/package-lock.json 은 npm 11+
# 로 생성되어 있어 npm 10 의 `npm ci` 가 거부합니다. npm 11 이 포함된 node:24 를 씁니다.
NODE_IMAGE=node:24-bookworm-slim

# DB / 인프라
POSTGRES_IMAGE=postgres:17-alpine
INFLUXDB_IMAGE=influxdb:2.7
NGINX_IMAGE=nginx:1.27-alpine

# ---------------------------------------------------------------------------
# 컨테이너 사용자 (Linux 호스트에서 bind mount 파일 소유권을 맞추기 위한 값)
# macOS / Docker Desktop 에서는 기본값 그대로 두면 됩니다. Linux 에서는 `id -u`, `id -g` 값 사용.
# ---------------------------------------------------------------------------
DOCKER_UID=1000
DOCKER_GID=1000
TZ=Asia/Seoul

# ---------------------------------------------------------------------------
# 호스트에 노출할 포트
# ---------------------------------------------------------------------------
BACKEND_PORT=8080
BACKEND_DEBUG_PORT=5005
FRONTEND_PORT=8081
STORYBOOK_PORT=6006
POSTGRES_PORT=5432
INFLUX_PORT=8086
WEB_PORT=8088
MQTT_PORT=1883
# TLS 리스너 포트. infra/mosquitto/certs/ 에 인증서가 있을 때만 실제로 뜬다
# (infra/mosquitto/generate-certs.sh, infra/mosquitto/README.md 참고).
MQTT_TLS_PORT=8883

# ---------------------------------------------------------------------------
# PostgreSQL (업무 데이터)
# ---------------------------------------------------------------------------
POSTGRES_DB=terrabyte
POSTGRES_USER=terrabyte
POSTGRES_PASSWORD=terrabyte

# ---------------------------------------------------------------------------
# InfluxDB 2.x (센서 시계열)
# ---------------------------------------------------------------------------
INFLUX_USERNAME=terrabyte
INFLUX_PASSWORD=terrabyte-admin-password
INFLUX_ORG=terrabyte
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=terrabyte-local-token

# ---------------------------------------------------------------------------
# MQTT (Mosquitto) — 게이트웨이 ↔ 백엔드 텔레메트리 전송
# infra/mosquitto/README.md 참고. 자격 증명은 로컬 개발 전용이며 비밀이 아니다.
# ---------------------------------------------------------------------------
MQTT_ENABLED=true
# 컨테이너 네트워크 안에서는 서비스명(mosquitto)으로 접근한다.
# 호스트에서 직접 붙을 때는 tcp://localhost:1883 로 바꾼다.
MQTT_URL=tcp://mosquitto:1883
MQTT_USERNAME=terrabyte-backend
MQTT_PASSWORD=terrabyte-backend-local
MQTT_TOPIC_PREFIX=tb/v2

# ---------------------------------------------------------------------------
# 백엔드 애플리케이션
# ---------------------------------------------------------------------------
JWT_ISSUER=terrabyte-backend
JWT_SECRET=terrabyte-local-development-secret-change-me-2026
JWT_ACCESS_TOKEN_TTL=PT1H
TELEMETRY_DEVICE_KEY=terrabyte-local-device-key
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:8088

# ---------------------------------------------------------------------------
# 프론트엔드 (Expo)
# ---------------------------------------------------------------------------
# 브라우저(호스트)에서 백엔드로 직접 요청하므로 컨테이너 이름이 아니라 localhost 를 씁니다.
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
# 실제 휴대폰의 Expo Go 로 붙을 때는 개발 PC 의 내부 IP 로 바꿉니다.
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.0.10:8080
#   REACT_NATIVE_PACKAGER_HOSTNAME=192.168.0.10
REACT_NATIVE_PACKAGER_HOSTNAME=localhost

# ---------------------------------------------------------------------------
# 배포 스택 전용 (docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# 빌드한 이미지에 붙일 태그.
IMAGE_TAG=local
# 백엔드를 별도 도메인에 두는 경우에만 절대 URL 을 넣습니다.
# 비워 두면 동일 출처(/api)로 요청하고 nginx 가 백엔드로 프록시합니다.
PROD_API_BASE_URL=
